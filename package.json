{
  "name": "linkedin-cli",
  "version": "0.1.0",
  "description": "Command-line client for LinkedIn messaging (Voyager API, cookie auth)",
  "type": "module",
  "bin": {
    "linkedin": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["linkedin", "cli", "messaging"],
  "author": "Bartosz Gotowski",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rei-x/linkedin-cli.git"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.6.2",
    "citty": "^0.2.2",
    "date-fns": "^4.1.0",
    "tough-cookie": "^6.0.1",
    "undici": "^8.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.8.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
